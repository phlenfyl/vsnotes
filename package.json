{
  "name": "notevs",
  "displayName": "NoteVs",
  "description": "A simple extension for notes and annotations",
  "version": "0.16.0",
  "icon": "media/icon-marketplace.png",
  "publisher": "MESHEmugles1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "license": "MIT",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "notevs",
          "title": "NoteVs",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "notevs": [
        {
          "type": "webview",
          "id": "notevs.notesView",
          "name": "Notes"
        }
      ]
    },
    "commands": [
      {
        "command": "notevs.openNotes",
        "title": "NoteVs: Open Notes"
      },
      {
        "command": "notevs.logout",
        "title": "NoteVs: Logout"
      },
      {
        "command": "notevs.annotateSelection",
        "title": "NoteVs: Annotate Selection"
      },
      {
        "command": "notevs.openNoteById",
        "title": "NoteVs: Open Note"
      },
      {
        "command": "notevs.exportNotes",
        "title": "NoteVs: Export Notes to .notevs/"
      },
      {
        "command": "notevs.importNotes",
        "title": "NoteVs: Import Notes from .notevs/"
      },
      {
        "command": "notevs.openAgentChat",
        "title": "NoteVs: Chat with Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "notevs.newAgentChat",
        "title": "NoteVs: New Agent Chat (archive current)",
        "icon": "$(add)"
      },
      {
        "command": "notevs.viewAgentHistory",
        "title": "NoteVs: View Past Agent Chats",
        "icon": "$(history)"
      },
      {
        "command": "notevs.configureAgentPath",
        "title": "NoteVs: Configure Agent Path"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "notevs.annotateSelection",
          "when": "editorHasSelection",
          "group": "notevs@1"
        }
      ],
      "editor/title": [
        {
          "command": "notevs.openAgentChat",
          "group": "navigation@1",
          "when": "activeWebviewPanelId != 'notevs.agentChat'"
        },
        {
          "command": "notevs.newAgentChat",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == 'notevs.agentChat'"
        },
        {
          "command": "notevs.viewAgentHistory",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == 'notevs.agentChat'"
        }
      ],
      "view/title": [
        {
          "command": "notevs.openAgentChat",
          "group": "navigation@1",
          "when": "view == notevs.notesView"
        }
      ]
    },
    "keybindings": [
      {
        "command": "notevs.annotateSelection",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "NoteVs",
      "properties": {
        "notevs.apiUrl": {
          "type": "string",
          "default": "https://notenest-backend.up.railway.app",
          "description": "NoteVs API URL"
        },
        "notevs.autoShow": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show notes when opening a project"
        },
        "notevs.noteBgColor": {
          "type": "string",
          "default": "#1e1e1e",
          "description": "Background colour for the note editor"
        },
        "notevs.noteTextColor": {
          "type": "string",
          "default": "#d4d4d4",
          "description": "Text colour for the note editor"
        },
        "notevs.notionAutoSync": {
          "type": "boolean",
          "default": false,
          "description": "Automatically push note updates to Notion 60s after you stop typing (only for notes already exported to Notion)"
        },
        "notevs.agentUrl": {
          "type": "string",
          "default": "http://localhost:5005",
          "description": "Local Rasa server URL for the NoteVs Agent chat panel"
        },
        "notevs.agentRepoPath": {
          "type": "string",
          "default": "",
          "description": "Optional. Point at your own agent.yml-containing folder to override NoteVs's built-in managed agent. Leave empty (default) — once both keys are set in Settings → Agent, NoteVs sets up and runs a bundled agent automatically, no manual steps needed."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run vendor:voice && npm run build && npm run build:bridge",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:audify --format=cjs --platform=node",
    "build:bridge": "esbuild src/mcpBridge.ts --bundle --outfile=dist/mcp-bridge.cjs --format=cjs --platform=node",
    "dev": "npm run build -- --watch",
    "vendor:voice": "rm -rf node_modules/audify node_modules/bindings node_modules/file-uri-to-path && mkdir -p node_modules/audify node_modules/bindings node_modules/file-uri-to-path && cp -R ../node_modules/audify/build node_modules/audify/build && cp ../node_modules/audify/index.js ../node_modules/audify/index.d.ts ../node_modules/audify/package.json node_modules/audify/ && cp -R ../node_modules/bindings/. node_modules/bindings/ && cp -R ../node_modules/file-uri-to-path/. node_modules/file-uri-to-path/",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MESHEmugles/vsnotes"
  },
  "dependencies": {
    "audify": "^1.10.1",
    "axios": "^1.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.3"
  }
}
