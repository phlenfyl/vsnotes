{
  "name": "projectnotes",
  "displayName": "ProjectNotes",
  "description": "Write notes for each VS Code project. Syncs to the cloud across all your machines.",
  "version": "0.0.1",
  "publisher": "YOUR_PUBLISHER_NAME",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectnotes",
          "title": "ProjectNotes",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "projectnotes": [
        {
          "type": "webview",
          "id": "projectnotes.notesView",
          "name": "Notes"
        }
      ]
    },
    "commands": [
      { "command": "projectnotes.openNotes", "title": "ProjectNotes: Open Notes" },
      { "command": "projectnotes.logout", "title": "ProjectNotes: Logout" }
    ],

    "configuration": {
      "title": "ProjectNotes",
      "properties": {
        "projectnotes.apiUrl": {
          "type": "string",
          "default": "https://vsnotes-backend.onrender.com",
          "description": "ProjectNotes API URL"
        },
        "projectnotes.autoShow": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show notes when opening a project"
        },
        "projectnotes.noteBgColor": {
          "type": "string",
          "default": "#1e1e1e",
          "description": "Background colour for the note editor"
        },
        "projectnotes.noteTextColor": {
          "type": "string",
          "default": "#d4d4d4",
          "description": "Text colour for the note editor"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "dev": "npm run build -- --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/projectnotes-extension"
  },
  "dependencies": {
    "axios": "^1.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
