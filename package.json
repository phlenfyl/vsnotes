{
  "name": "notenest",
  "displayName": "NoteNest",
  "description": "Write notes for each VS Code project. Syncs to the cloud across all your machines.",
  "version": "0.0.1",
  "icon": "media/icon-marketplace.png",
  "publisher": "YOUR_PUBLISHER_NAME",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "notenest",
          "title": "NoteNest",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "notenest": [
        {
          "type": "webview",
          "id": "notenest.notesView",
          "name": "Notes"
        }
      ]
    },
    "commands": [
      { "command": "notenest.openNotes", "title": "NoteNest: Open Notes" },
      { "command": "notenest.logout", "title": "NoteNest: Logout" },
      { "command": "notenest.annotateSelection", "title": "NoteNest: Annotate Selection" },
      { "command": "notenest.openNoteById", "title": "NoteNest: Open Note" }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "notenest.annotateSelection",
          "when": "editorHasSelection",
          "group": "notenest@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "notenest.annotateSelection",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "editorHasSelection"
      }
    ],

    "configuration": {
      "title": "NoteNest",
      "properties": {
        "notenest.apiUrl": {
          "type": "string",
          "default": "https://vsnotes-backend.onrender.com",
          "description": "NoteNest API URL"
        },
        "notenest.autoShow": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show notes when opening a project"
        },
        "notenest.noteBgColor": {
          "type": "string",
          "default": "#1e1e1e",
          "description": "Background colour for the note editor"
        },
        "notenest.noteTextColor": {
          "type": "string",
          "default": "#d4d4d4",
          "description": "Text colour for the note editor"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "dev": "npm run build -- --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/notenest-extension"
  },
  "dependencies": {
    "axios": "^1.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
